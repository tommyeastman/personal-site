---
import { education, volunteering } from "../data/resume";
---

<section aria-labelledby="edu-heading" class="wrap border-t border-line py-16 sm:py-24">
  <div class="grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="edu-heading" class="display text-[clamp(2rem,3.5vw,3rem)]">Education</h2>
      <p class="mt-6 text-xl font-medium">{education.school}</p>
      <p class="mt-1 text-muted">{education.degree}, {education.year}</p>
      <p class="text-muted">{education.detail}</p>
    </div>
    <div class="lg:col-span-7 lg:pt-3" data-reveal>
      <ul class="bullets max-w-[60ch] space-y-3">
        {education.highlights.map((h) => <li>{h}</li>)}
      </ul>
      <div class="mt-10 max-w-[60ch] border-t border-line pt-6">
        <p class="font-medium">
          {volunteering.org}
          <span class="text-muted">
            <span aria-hidden="true"> · </span>
            <span class="sr-only">, </span>
            {volunteering.role}, {volunteering.years}
          </span>
        </p>
        <p class="mt-1 text-muted">{volunteering.detail}</p>
      </div>
    </div>
  </div>
</section>
