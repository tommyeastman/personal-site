---
import { Icon } from "astro-icon/components";
import { roles } from "../data/resume";
---

<section id="experience" aria-labelledby="experience-heading" class="wrap py-16 sm:py-24">
  <div class="lg:grid lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-24">
        <h2 id="experience-heading" class="display text-[clamp(2rem,3.5vw,3rem)]">Experience</h2>
        <p class="mt-4 max-w-[34ch] text-muted">
          Twelve years across insurance, lending, consumer apps, and quantitative consulting.
        </p>
        <ol class="mt-10 hidden lg:block" data-rail>
          {
            roles.map((role, i) => (
              <li>
                <a href={`#${role.id}`} class="rail-link" aria-current={i === 0 ? "true" : undefined}>
                  <span>{role.company}</span>
                  <span class="text-sm tabular-nums">{role.years}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="mt-10 lg:col-span-8 lg:mt-0">
      {
        roles.map((role) => {
          const visible = role.visible ?? role.bullets.length;
          const shown = role.bullets.slice(0, visible);
          const rest = role.bullets.slice(visible);
          return (
            <article id={role.id} data-reveal class="scroll-mt-20 border-t border-line py-8 sm:py-10">
              <header class="role-head">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                  <h3
                    class:list={[
                      "font-semibold tracking-tight",
                      role.compact ? "text-lg" : "text-xl sm:text-2xl",
                    ]}
                  >
                    {role.company}
                  </h3>
                  <p class="text-sm text-muted tabular-nums">
                    {role.start} to {role.end}
                  </p>
                </div>
                <p class="mt-1 text-muted">
                  {role.title}
                  <span aria-hidden="true"> · </span>
                  <span class="sr-only">, </span>
                  {role.location}
                </p>
              </header>

              {role.summary && <p class="mt-5 max-w-[62ch] text-muted">{role.summary}</p>}

              <ul class:list={["bullets max-w-[66ch]", role.compact ? "mt-4 space-y-2 text-[15px]" : "mt-5 space-y-3"]}>
                {shown.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>

              {rest.length > 0 && (
                <details class="more mt-4">
                  <summary>
                    <Icon name="ph:plus-bold" size={16} class="icon" aria-hidden="true" />
                    <span class="when-closed">Show {rest.length} more</span>
                    <span class="when-open">Show less</span>
                  </summary>
                  <ul class="bullets mt-4 max-w-[66ch] space-y-3">
                    {rest.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </details>
              )}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Scroll spy for the desktop rail: an entry becomes current when it crosses a band
  // 20% to 40% down the viewport.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-rail] .rail-link"));
  const byId = new Map(links.map((a) => [a.getAttribute("href")!.slice(1), a]));
  const targets = Array.from(byId.keys())
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0 && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute("aria-current"));
          byId.get(entry.target.id)?.setAttribute("aria-current", "true");
        }
      },
      { rootMargin: "-20% 0px -60% 0px", threshold: 0 },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
