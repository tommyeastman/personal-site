---
import { Icon } from "astro-icon/components";
import { person } from "../data/resume";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="nav">
  <div class="wrap flex h-full items-center justify-between">
    <a href="#top" class="font-medium tracking-tight">{person.name}</a>
    <nav aria-label="Primary" class="flex items-center gap-1">
      <a class="navlink" href={person.linkedin} target="_blank" rel="noreferrer">
        <Icon name="ph:linkedin-logo" size={18} aria-hidden="true" />
        <span class="hidden sm:inline">LinkedIn</span>
        <span class="sr-only sm:hidden">LinkedIn</span>
      </a>
      <a class="navlink" href={person.resumePath} target="_blank" rel="noreferrer">
        <Icon name="ph:file-arrow-down" size={18} aria-hidden="true" />
        <span class="hidden sm:inline">Resume</span>
        <span class="sr-only sm:hidden">Resume (PDF)</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
